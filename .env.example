# Copy this file to .env and fill in real values. .env is git-ignored — never commit real keys.

# Required — Anthropic API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model tiers (defaults shown). Sonnet does analysis/writing/critique; Haiku does routing, guardrails, classification.
SO_MODEL_STRONG=claude-sonnet-5
SO_MODEL_FAST=claude-haiku-4-5

# Required by SEC EDGAR — identify yourself (any name + email; SEC policy)
EDGAR_IDENTITY=Your Name your.email@example.com

# Optional — Reddit retail-sentiment. Leave blank to fall back to analyst-consensus-only sentiment.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=second-opinion/0.1 by your_reddit_username

# Optional — news. Leave blank to use yfinance news headlines only.
FINNHUB_API_KEY=

# Behaviour
SO_OFFLINE=0            # 1 = never hit the network; serve only from cache/fixtures (used by tests & evals)
SO_CRITIC_ENABLED=1     # 0 = disable the Risk Critic (eval ablation switch)
SO_MAX_CRITIC_ROUNDS=2
